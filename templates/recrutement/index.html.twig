{% extends 'base.html.twig' %}

{% block body %}
{% set role = app.user.role.value %}
<div class="max-w-6xl mx-auto py-10">

    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Gestion des Recrutements</h1>
        {% if role == 'ROLE_ADMIN' or role == 'ROLE_PRESIDENT' or role == 'ROLE_RESPONSABLE' %}
            <a href="{{ path('app_recrutement_new') }}"
               class="bg-indigo-600 text-white px-4 py-2 rounded">Ajouter</a>
        {% endif %}
    </div>

    <table class="w-full mt-5 bg-white border">
        <thead>
            <tr class="border-b text-left text-sm text-gray-500">
                <th class="p-4">Titre</th>
                <th class="p-4">Club</th>
                <th class="p-4">Deadline</th>
                <th class="p-4">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for r in recrutements %}
            <tr class="border-b">
                <td class="p-4">{{ r.title }}</td>
                <td class="p-4">{{ r.clubId.name }}</td>
                <td class="p-4">{{ r.deadline|date('d/m/Y') }}</td>
                <td class="p-4 flex gap-2">

                    {# ETUDIANT - postuler seulement #}
                    {% if role == 'etudiant' %}
                        <a href="{{ path('app_candidature_new') }}"
                           class="text-green-500">Postuler</a>

                    {# RESPONSABLE - modifier seulement #}
                    {% elseif role == 'ROLE_RESPONSABLE' %}
                        <a href="{{ path('app_recrutement_edit', {id: r.id}) }}"
                           class="text-blue-500">Modifier</a>

                    {# PRESIDENT - modifier + supprimer #}
                    {% elseif role == 'ROLE_PRESIDENT' %}
                        <a href="{{ path('app_recrutement_edit', {id: r.id}) }}"
                           class="text-blue-500">Modifier</a>
                        <form method="post" action="{{ path('app_recrutement_delete', {id: r.id}) }}"
                              onsubmit="return confirm('Confirmer ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.id) }}">
                            <button class="text-red-500">Supprimer</button>
                        </form>

                    {# ADMIN - tout #}
                    {% else %}
                        <a href="{{ path('app_recrutement_edit', {id: r.id}) }}"
                           class="text-blue-500">Modifier</a>
                        <form method="post" action="{{ path('app_recrutement_delete', {id: r.id}) }}"
                              onsubmit="return confirm('Confirmer ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.id) }}">
                            <button class="text-red-500">Supprimer</button>
                        </form>
                    {% endif %}

                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}