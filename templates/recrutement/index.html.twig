{% extends 'base.html.twig' %}
{% block body %}
<div class="max-w-6xl mx-auto py-10">
    <h1 class="text-2xl font-bold mb-6">Gestion des Recrutements</h1>
    <a href="{{ path('app_recrutement_new') }}" class="bg-indigo-600 text-white px-4 py-2 rounded">Ajouter</a>
    
    <table class="w-full mt-5 bg-white border">
        <thead><tr class="border-b text-left text-sm text-gray-500">
            <th class="p-4">Titre</th><th class="p-4">Club</th><th class="p-4">Deadline</th><th class="p-4">Actions</th>
        </tr></thead>
        <tbody>
            {% for r in recrutements %}
            <tr class="border-b">
                <td class="p-4">{{ r.title }}</td>
                <td class="p-4">{{ r.clubId.name }}</td>
                <td class="p-4">{{ r.deadline|date('d/m/Y') }}</td>
                <td class="p-4 flex gap-2">
                    <a href="{{ path('app_recrutement_edit', {id: r.id}) }}" class="text-blue-500">Edit</a>
                    <form method="post" action="{{ path('app_recrutement_delete', {id: r.id}) }}" onsubmit="return confirm('Confirmer ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.id) }}">
                        <button class="text-red-500">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}