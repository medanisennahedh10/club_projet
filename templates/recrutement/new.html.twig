{% extends 'base.html.twig' %}

{% block title %}Nouveau Recrutement{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 py-10">
    <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Nouveau Recrutement</h1>
            <p class="text-sm text-gray-500 mt-1">Ajoutez une nouvelle offre de recrutement.</p>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="space-y-5">
            <div>
                {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300'}}) }}
            </div>

            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm h-32'}}) }}
            </div>

            <div>
                {{ form_label(form.requirements, 'Prérequis', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.requirements, {'attr': {'class': 'w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm'}}) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.deadline, 'Date limite', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.deadline, {'attr': {'class': 'w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm'}}) }}
                </div>
                <div>
                    {{ form_label(form.status, 'Statut', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.status, {'attr': {'class': 'w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm'}}) }}
                </div>
            </div>

            <div>
                {{ form_label(form.club_id, 'Club', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.club_id, {'attr': {'class': 'w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm'}}) }}
            </div>

            <div class="pt-4 border-t border-gray-100">
                <button type="submit" class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-indigo-700 text-sm w-full">Enregistrer</button>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}