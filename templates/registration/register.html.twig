{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<div class="min-h-screen flex items-center justify-center" style="background: var(--color-background-tertiary); padding: 2rem 1rem;">
    <div style="background: var(--color-background-primary); border-radius: var(--border-radius-lg); border: 0.5px solid var(--color-border-tertiary); padding: 2.5rem; width: 100%; max-width: 440px;">

        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: #E6F1FB; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                <i class="ti ti-user-plus" style="font-size: 22px; color: #185FA5;"></i>
            </div>
            <h2 style="font-size: 22px; font-weight: 500; color: var(--color-text-primary); margin: 0 0 4px;">Créer un compte</h2>
            <p style="font-size: 14px; color: var(--color-text-secondary); margin: 0;">Rejoignez la communauté ISET Clubs</p>
        </div>

        {{ form_start(registrationForm) }}

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
            <div>
                <label style="font-size: 13px; color: var(--color-text-secondary); display: block; margin-bottom: 4px;">Prénom</label>
                {{ form_widget(registrationForm.firstname, {'attr': {'placeholder': 'Prénom', 'style': 'width: 100%; box-sizing: border-box;'}}) }}
            </div>
            <div>
                <label style="font-size: 13px; color: var(--color-text-secondary); display: block; margin-bottom: 4px;">Nom</label>
                {{ form_widget(registrationForm.lastname, {'attr': {'placeholder': 'Nom', 'style': 'width: 100%; box-sizing: border-box;'}}) }}
            </div>
        </div>

        <div style="margin-bottom: 12px;">
            <label style="font-size: 13px; color: var(--color-text-secondary); display: block; margin-bottom: 4px;">Email</label>
            {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'vous@example.com', 'style': 'width: 100%; box-sizing: border-box;'}}) }}
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label style="font-size: 13px; color: var(--color-text-secondary); display: block; margin-bottom: 4px;">Mot de passe</label>
            {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': '••••••••', 'style': 'width: 100%; box-sizing: border-box;'}}) }}
        </div>

        <button type="submit"
                class="w-full bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 transition-colors font-medium">
            S'inscrire
        </button>

        {{ form_end(registrationForm) }}

        <p style="text-align: center; font-size: 13px; color: var(--color-text-secondary); margin-top: 1.5rem; margin-bottom: 0;">
            Déjà inscrit ? <a href="{{ path('app_login') }}" style="color: #185FA5; text-decoration: none;">Se connecter</a>
        </p>

    </div>
</div>

{% endblock %}