{% extends 'base.html.twig' %}

{% block title %}Nouvelle Réclamation{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        
        {# Header style Tailwind #}
        <div class="bg-indigo-600 px-6 py-4">
            <h3 class="text-lg font-bold text-white">Ajouter une nouvelle réclamation</h3>
        </div>
        
        <div class="p-6">
            {{ form_start(form) }}
                <div class="space-y-5">
                    {# Sujet #}
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Sujet</label>
                        {{ form_widget(form.subject, {'attr': {'class': 'w-full rounded-xl border-gray-200 shadow-xs text-sm focus:border-indigo-500 focus:ring-indigo-500 p-2.5 bg-gray-50/50 border'}}) }}
                    </div>
                    
                    {# Message #}
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                        {{ form_widget(form.message, {'attr': {'class': 'w-full rounded-xl border-gray-200 shadow-xs text-sm focus:border-indigo-500 focus:ring-indigo-500 p-2.5 bg-gray-50/50 border', 'rows': 5}}) }}
                    </div>
                    
                    {# Statut #}
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
                        {{ form_widget(form.status, {'attr': {'class': 'w-full rounded-xl border-gray-200 shadow-xs text-sm focus:border-indigo-500 focus:ring-indigo-500 p-2.5 bg-gray-50/50 border'}}) }}
                    </div>
                    
                    {# Relation back to User #}
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Utilisateur / Membre</label>
                        {{ form_widget(form.user_id, {'attr': {'class': 'w-full rounded-xl border-gray-200 shadow-xs text-sm focus:border-indigo-500 focus:ring-indigo-500 p-2.5 bg-gray-50/50 border'}}) }}
                    </div>
                </div>

                {# Les Boutons #}
                <div class="mt-8 flex gap-3 border-t border-gray-50 pt-5">
                    <button class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-indigo-700 shadow-xs transition-all">
                        Enregistrer
                    </button>
                    <a href="{{ path('app_reclamation_index') }}" class="bg-gray-100 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-gray-200 transition-all">
                        Retour
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}