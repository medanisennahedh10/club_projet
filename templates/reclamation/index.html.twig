{% extends 'base.html.twig' %}

{% block title %}Recrutements{% endblock %}

{% block body %}
{% set role = app.user.role.value %}
<div class="max-w-7xl mx-auto px-4 py-8">

    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Recrutements</h1>
            <p class="text-gray-500">Liste de toutes les offres de recrutement.</p>
        </div>
        {% if role == 'ROLE_ADMIN' or role == 'ROLE_PRESIDENT' or role == 'ROLE_RESPONSABLE' %}
            <a href="{{ path('app_recrutement_new') }}"
               class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2.5 rounded-xl shadow-lg transition-all">
                + Nouveau Recrutement
            </a>
        {% endif %}
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
        <table class="w-full text-left">
            <thead class="text-gray-500 border-b border-gray-100">
                <tr>
                    <th class="p-5 font-medium">Titre</th>
                    <th class="p-5 font-medium">Club</th>
                    <th class="p-5 font-medium">Date limite</th>
                    <th class="p-5 font-medium">Statut</th>
                    <th class="p-5 font-medium">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
            {% for r in recrutements %}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="p-5 font-semibold text-gray-800">{{ r.title }}</td>
                    <td class="p-5 text-gray-600">{{ r.clubId ? r.clubId.name : 'N/A' }}</td>
                    <td class="p-5 text-gray-600">{{ r.deadline|date('d/m/Y') }}</td>
                    <td class="p-5">
                        <span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
                            {{ r.status }}
                        </span>
                    </td>
                    <td class="p-5">
                        <div class="flex gap-4">

                            {# ETUDIANT - postuler seulement #}
                            {% if role == 'etudiant' %}
                                <a href="{{ path('app_candidature_new') }}"
                                   class="text-green-600 hover:underline">Postuler</a>

                            {# RESPONSABLE - modifier seulement #}
                            {% elseif role == 'ROLE_RESPONSABLE' %}
                                <a href="{{ path('app_recrutement_edit', {'id': r.id}) }}"
                                   class="text-indigo-600 hover:underline">Modifier</a>

                            {# PRESIDENT - modifier + supprimer #}
                            {% elseif role == 'ROLE_PRESIDENT' %}
                                <a href="{{ path('app_recrutement_edit', {'id': r.id}) }}"
                                   class="text-indigo-600 hover:underline">Modifier</a>
                                <form method="post" action="{{ path('app_recrutement_delete', {'id': r.id}) }}"
                                      onsubmit="return confirm('Supprimer ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.id) }}">
                                    <button class="text-red-600 hover:underline">Supprimer</button>
                                </form>

                            {# ADMIN - tout #}
                            {% else %}
                                <a href="{{ path('app_recrutement_edit', {'id': r.id}) }}"
                                   class="text-indigo-600 hover:underline">Modifier</a>
                                <form method="post" action="{{ path('app_recrutement_delete', {'id': r.id}) }}"
                                      onsubmit="return confirm('Supprimer ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.id) }}">
                                    <button class="text-red-600 hover:underline">Supprimer</button>
                                </form>
                            {% endif %}

                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}