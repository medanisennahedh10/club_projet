{% extends 'base.html.twig' %}

{% block title %}Gestion des Membres des Clubs{% endblock %}

{% block body %}
{% set role = app.user.role.value %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Membres des Clubs</h1>
            <p class="text-sm text-gray-500 mt-1">Affectation et rôles des étudiants au sein des clubs.</p>
        </div>
        {% if role == 'ROLE_ADMIN' or role == 'ROLE_PRESIDENT' %}
            <a href="{{ path('app_club_member_new') }}"
               class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-all">
                + Affecter un Membre
            </a>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-6 p-4 text-sm text-green-700 bg-green-50 border border-green-200 rounded-xl">
            {{ message }}
        </div>
    {% endfor %}

    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-gray-50 text-gray-500 border-b border-gray-100">
                    <tr>
                        <th class="p-4 font-medium">Utilisateur</th>
                        <th class="p-4 font-medium">Club</th>
                        <th class="p-4 font-medium">Rôle</th>
                        <th class="p-4 font-medium">Date d'adhésion</th>
                        <th class="p-4 font-medium text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-gray-700">
                {% for club_member in club_members %}
                    <tr class="hover:bg-gray-50/50 transition-colors">

                        <td class="p-4 font-semibold text-gray-900">{{ club_member.userId.email }}</td>

                        <td class="p-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                                {{ club_member.clubId.name }}
                            </span>
                        </td>

                        <td class="p-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                {% if club_member.role == 'Président' %} bg-amber-50 text-amber-700 border border-amber-100
                                {% elseif club_member.role == 'Responsable' %} bg-blue-50 text-blue-700 border border-blue-100
                                {% else %} bg-gray-50 text-gray-600 border border-gray-100
                                {% endif %}">
                                {{ club_member.role }}
                            </span>
                        </td>

                        <td class="p-4 text-gray-500">{{ club_member.joinedAt ? club_member.joinedAt|date('Y-m-d H:i') : '' }}</td>

                        <td class="p-4 text-center">
                            <div class="flex items-center justify-center gap-3">

                                {# ETUDIANT - voir seulement #}
                                {% if role == 'etudiant' %}
                                    <span class="text-gray-400 text-xs">—</span>

                                {# RESPONSABLE - voir seulement #}
                                {% elseif role == 'ROLE_RESPONSABLE' %}
                                    <span class="text-gray-400 text-xs">—</span>

                                {# PRESIDENT - modifier + supprimer #}
                                {% elseif role == 'ROLE_PRESIDENT' %}
                                    <a href="{{ path('app_club_member_edit', {'id': club_member.id}) }}"
                                       class="text-indigo-600 hover:text-indigo-900 font-medium text-xs">Modifier</a>
                                    <form method="post" action="{{ path('app_club_member_delete', {'id': club_member.id}) }}"
                                          onsubmit="return confirm('Êtes-vous sûr ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ club_member.id) }}">
                                        <button class="text-red-600 hover:text-red-900 font-medium text-xs">Supprimer</button>
                                    </form>

                                {# ADMIN - tout #}
                                {% else %}
                                    <a href="{{ path('app_club_member_edit', {'id': club_member.id}) }}"
                                       class="text-indigo-600 hover:text-indigo-900 font-medium text-xs">Modifier</a>
                                    <form method="post" action="{{ path('app_club_member_delete', {'id': club_member.id}) }}"
                                          onsubmit="return confirm('Êtes-vous sûr ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ club_member.id) }}">
                                        <button class="text-red-600 hover:text-red-900 font-medium text-xs">Supprimer</button>
                                    </form>
                                {% endif %}

                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="p-8 text-center text-gray-500">Aucun membre enregistré.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}