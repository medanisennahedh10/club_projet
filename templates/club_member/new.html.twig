{% extends 'base.html.twig' %}

{% block title %}Affecter un Membre{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-10">
    <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">Affecter un Membre à un Club</h1>

        {{ form_start(form) }}
            <div class="space-y-5">
                <div>
                    {{ form_row(form.user_id) }}
                </div>
                <div>
                    {{ form_row(form.club_id) }}
                </div>
                <div>
                    {{ form_row(form.role) }}
                </div>
                
                <div class="flex gap-3 pt-4 border-t border-gray-100">
                    <button class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-indigo-700 text-sm shadow-sm">Enregistrer</button>
                    <a href="{{ path('app_club_member_index') }}" class="bg-gray-100 text-gray-700 px-5 py-2.5 rounded-xl font-semibold hover:bg-gray-200 text-sm">Annuler</a>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}