{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

<div class="min-h-screen flex items-center justify-center" style="background: var(--color-background-tertiary); padding: 2rem 1rem;">
    <div style="background: var(--color-background-primary); border-radius: var(--border-radius-lg); border: 0.5px solid var(--color-border-tertiary); padding: 2.5rem; width: 100%; max-width: 440px;">

        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: #E6F1FB; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                <i class="ti ti-lock" style="font-size: 22px; color: #185FA5;"></i>
            </div>
            <h2 style="font-size: 22px; font-weight: 500; color: var(--color-text-primary); margin: 0 0 4px;">Connexion</h2>
            <p style="font-size: 14px; color: var(--color-text-secondary); margin: 0;">Bienvenue sur ISET Clubs</p>
        </div>

        {% if error %}
            <div style="background: #FCEBEB; border: 0.5px solid #F09595; border-radius: var(--border-radius-md); padding: 12px; margin-bottom: 1rem; font-size: 13px; color: #A32D2D; text-align: center;">
                ✗ Identifiants incorrects
            </div>
        {% endif %}

        <form method="post">

            <div style="margin-bottom: 12px;">
                <label style="font-size: 13px; color: var(--color-text-secondary); display: block; margin-bottom: 4px;">Email</label>
                <input type="email"
                       name="_username"
                       value="{{ last_username }}"
                       placeholder="vous@example.com"
                       style="width: 100%; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="font-size: 13px; color: var(--color-text-secondary); display: block; margin-bottom: 4px;">Mot de passe</label>
                <input type="password"
                       name="_password"
                       placeholder="••••••••"
                       style="width: 100%; box-sizing: border-box;">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit"
                    class="w-full bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 transition-colors font-medium">
                Se connecter
            </button>

        </form>

        <p style="text-align: center; font-size: 13px; color: var(--color-text-secondary); margin-top: 1.5rem; margin-bottom: 0;">
            Pas encore de compte ? <a href="{{ path('app_register') }}" style="color: #185FA5; text-decoration: none;">S'inscrire</a>
        </p>

    </div>
</div>

{% endblock %}