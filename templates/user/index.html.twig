{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {# Header #}
    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Utilisateurs</h1>
            <p class="text-sm text-gray-500 mt-1">Liste de tous les utilisateurs enregistrés.</p>
        </div>
        <a href="{{ path('app_user_new') }}"
           class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-all">
            + Nouvel Utilisateur
        </a>
    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="mb-6 p-4 text-sm text-green-700 bg-green-50 border border-green-200 rounded-xl">
            {{ message }}
        </div>
    {% endfor %}

    {# Table #}
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-gray-50 text-gray-500 border-b border-gray-100">
                    <tr>
                        <th class="p-4 font-medium">Photo</th>
                        <th class="p-4 font-medium">Nom complet</th>
                        <th class="p-4 font-medium">Email</th>
                        <th class="p-4 font-medium">Rôle</th>
                        <th class="p-4 font-medium">Type</th>
                        <th class="p-4 font-medium">Vérifié</th>
                        <th class="p-4 font-medium text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-gray-700">
                {% for user in users %}
                    <tr class="hover:bg-gray-50/50 transition-colors">

                        {# Photo #}
                        <td class="p-4">
                            {% if user.profilePicture %}
                                <img src="{{ asset('pdp/' ~ user.profilePicture) }}"
                                     alt="Photo"
                                     class="w-9 h-9 rounded-full object-cover border border-gray-200">
                            {% else %}
                                <div class="w-9 h-9 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-xs">
                                    {{ user.firstname|slice(0,1)|upper }}{{ user.lastname|slice(0,1)|upper }}
                                </div>
                            {% endif %}
                        </td>

                        {# Nom #}
                        <td class="p-4 font-semibold text-gray-900">
                            {{ user.firstname }} {{ user.lastname }}
                        </td>

                        {# Email #}
                        <td class="p-4 text-gray-500">{{ user.email }}</td>

                        {# Rôle (enum UserRole) #}
                        <td class="p-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                {% if user.role.value == 'ROLE_ADMIN' %} bg-red-50 text-red-700 border border-red-100
                                {% elseif user.role.value == 'ROLE_TEACHER' %} bg-blue-50 text-blue-700 border border-blue-100
                                {% else %} bg-gray-50 text-gray-600 border border-gray-100
                                {% endif %}">
                                {{ user.role.value }}
                            </span>
                        </td>

                        {# Dtype #}
                        <td class="p-4 text-gray-500">{{ user.dtype ?? '—' }}</td>

                        {# Vérifié #}
                        <td class="p-4">
                            {% if user.isVerified %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-100">
                                    ✓ Oui
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-50 text-gray-400 border border-gray-100">
                                    ✗ Non
                                </span>
                            {% endif %}
                        </td>

                        {# Actions #}
                        <td class="p-4 text-center">
                            <div class="flex items-center justify-center gap-3">
                                <a href="{{ path('app_user_edit', {'id': user.id}) }}"
                                   class="text-indigo-600 hover:text-indigo-900 font-medium text-xs">
                                   Modifier
                                </a>
                                <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}"
                                      onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="text-red-600 hover:text-red-900 font-medium text-xs">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="p-8 text-center text-gray-500">
                            Aucun utilisateur enregistré.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}