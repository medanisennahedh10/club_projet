{% extends 'base_dashbord.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}

<div style="display: flex; min-height: calc(100vh - 64px);">

    <!-- SIDEBAR -->
    <div style="width: 220px; background: var(--color-background-primary); border-right: 0.5px solid var(--color-border-tertiary); padding: 1.5rem 0; flex-shrink: 0; background: white; border-right: 1px solid #f0f0f0;">

        <div style="padding: 0 1rem 1.5rem; border-bottom: 1px solid #f0f0f0; margin-bottom: 1rem;">
            <a href="{{ path('app_profile') }}" style="text-decoration: none;">
    <div style="width: 44px; height: 44px; border-radius: 50%; background: #E6F1FB; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; cursor: pointer;">
        <i class="ti ti-user" style="font-size: 20px; color: #185FA5;"></i>
    </div>
</a>
            <p style="font-size: 14px; font-weight: 500; margin: 0; color: #111;">{{ user.firstname }} {{ user.lastname }}</p>
            <p style="font-size: 12px; color: #888; margin: 0;">{{ user.email }}</p>
        </div>

        <nav>
            <a href="{{ path('app_dashbord') }}" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #185FA5; text-decoration: none; border-left: 3px solid #185FA5; background: #E6F1FB;">
                <i class="ti ti-layout-dashboard" style="font-size: 18px;"></i> Dashboard
            </a>
            <a href="/user" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-users" style="font-size: 18px;"></i> Users
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-building-community" style="font-size: 18px;"></i> Clubs
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-alert-circle" style="font-size: 18px;"></i> Reclamation
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-user-check" style="font-size: 18px;"></i> Club Member
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-calendar-event" style="font-size: 18px;"></i> Evenement
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-briefcase" style="font-size: 18px;"></i> Recrutement
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-file-text" style="font-size: 18px;"></i> Candidature
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-ticket" style="font-size: 18px;"></i> Participation
            </a>
            <a href="#" style="display: flex; align-items: center; gap: 10px; padding: 10px 1rem; font-size: 14px; color: #555; text-decoration: none; border-left: 3px solid transparent;">
                <i class="ti ti-message-circle" style="font-size: 18px;"></i> Feedback
            </a>
        </nav>

    </div>

    <!-- MAIN CONTENT -->
    <div style="flex: 1; padding: 2rem;">

        <h2 style="font-size: 20px; font-weight: 500; margin: 0 0 1.5rem;">Bonjour, {{ user.firstname }} 👋</h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px;">
            <div style="background: #f8f9fa; border-radius: 8px; padding: 1rem; text-align: center;">
                <i class="ti ti-users" style="font-size: 28px; color: #185FA5;"></i>
                <p style="font-size: 13px; color: #888; margin: 8px 0 4px;">Clubs</p>
                <p style="font-size: 22px; font-weight: 500; margin: 0;">0</p>
            </div>
            <div style="background: #f8f9fa; border-radius: 8px; padding: 1rem; text-align: center;">
                <i class="ti ti-calendar-event" style="font-size: 28px; color: #185FA5;"></i>
                <p style="font-size: 13px; color: #888; margin: 8px 0 4px;">Événements</p>
                <p style="font-size: 22px; font-weight: 500; margin: 0;">0</p>
            </div>
            <div style="background: #f8f9fa; border-radius: 8px; padding: 1rem; text-align: center;">
                <i class="ti ti-file-text" style="font-size: 28px; color: #185FA5;"></i>
                <p style="font-size: 13px; color: #888; margin: 8px 0 4px;">Candidatures</p>
                <p style="font-size: 22px; font-weight: 500; margin: 0;">0</p>
            </div>
        </div>

    </div>

</div>

{% endblock %}