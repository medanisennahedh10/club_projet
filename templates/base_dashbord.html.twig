<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ISET Clubs{% endblock %}</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50 text-gray-900 flex flex-col min-h-screen">

    <nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">

                <div class="flex items-center gap-3">
                    <img src="{{ asset('image/logo.png') }}" alt="Logo ISET" class="h-10 w-auto object-contain">
                    <div class="flex flex-col">
                        <span class="text-xl font-bold tracking-tight text-indigo-600 leading-none">ISET<span class="text-gray-900">Clubs</span></span>
                        <span class="text-[10px] text-gray-500 font-medium mt-0.5">Zaghouan</span>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    {% if app.user %}
                        <span class="text-sm text-gray-600 hidden sm:inline">Hi, <strong>{{ app.user.firstname }}</strong></span>
                        <a href="{{ path('app_logout') }}" class="text-sm font-medium text-red-600 hover:text-red-700 transition-colors">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Connexion</a>
                        <a href="{{ path('app_register') }}" class="text-sm font-medium bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm shadow-indigo-100">S'inscrire</a>
                    {% endif %}
                </div>

            </div>
        </div>
    </nav>

    {% block body %}{% endblock %}

    <footer class="bg-white border-t border-gray-100 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-sm text-gray-500">
            &copy; 2026 ISET Zaghouan. Projet Symfony - 2ème année DSI.
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>